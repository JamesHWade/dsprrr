# dsprrr Environment Variables
# Copy this file to .Renviron and fill in your API keys
# .Renviron is gitignored and will not be committed

# LLM API Keys (at least one required for LLM tests)
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Optional: Google AI
GOOGLE_API_KEY=your-google-key-here

# Optional: Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Development settings
# Set to "true" to run tests against real APIs (uses VCR cassettes by default)
# DSPRRR_USE_REAL_API=false
